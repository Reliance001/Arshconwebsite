<!DOCTYPE html>
<html lang="en">
  <%- include('./partials/head.ejs') %>

  <body>
    <div class="container">

      <header>
        <%- include('./partials/nav.ejs') %>
      </header>

      <!-- Hero -->
      <section class="project-hero">

        <img
          src="<%= project.banner?.url || '/images/default-project.jpg' %>"
          alt="<%= project.title %>"
        />

        <div class="hero-overlay">
          <h1><%= project.title %></h1>
          <p><%= project.category %></p>
        </div>

      </section>

      <!-- Project Details -->
      <section class="project-details">

        <!-- Meta -->
        <div class="project-meta">

          <p>
            <strong>Location:</strong>
            <%= project.location %>
          </p>

          <p>
            <strong>Status:</strong>
            <%= project.status %>
          </p>

          <p>
            <strong>Completion Date:</strong>

            <%= new Date(project.completionDate)
              .toLocaleDateString(
                'en-NG',
                {
                  day: 'numeric',
                  month: 'long',
                  year: 'numeric'
                }
              ) %>

          </p>

        </div>

        <!-- Description -->
        <div class="project-about">

          <h2>About the Project</h2>

          <p id="project-description">
            <%- project.description %>
          </p>

        </div>

        <!-- Gallery -->
    <div class="project-gallery">

    <div class="gallery-header">

        <h2>Project Gallery</h2>

        <p>
            <%= project.gallery.length %> Photos
        </p>

    </div>

    <div class="gallery-grid">

        <% project.gallery.forEach((image,index)=>{ %>

            <div class="gallery-item">

                <img
                    src="<%= image.url %>"
                    alt="<%= project.title %>"
                    data-index="<%= index %>"
                    class="gallery-image"
                >

                <div class="gallery-overlay">

                    <span>View Photo</span>

                </div>

            </div>

        <% }) %>

    </div>

</div>

        <!-- Testimonial -->
        <% if (
          project.testimonial?.text 
        ) { %>

          <div class="testimonial">

            <h3>
              Client Testimonial
            </h3>

            <p>
              <%= project.testimonial.text %>
            </p>

          </div>

        <% } %>

        <!-- CTA -->
        <div class="cta">

          <h2>
            Interested in a Similar Project?
          </h2>

          <p>
            Contact us to discuss your next big idea!
          </p>

          <a
            href="/contact"
            class="pD-btn"
          >
            Get in Touch
          </a>

        </div>

      </section>

      <%- include('./partials/footer.ejs') %>

    </div>

<div class="lightbox" id="lightbox">

    <button class="close-btn">&times;</button>

    <button class="prev-btn">&#10094;</button>

    <img id="lightbox-image">

    <button class="next-btn">&#10095;</button>

    <div class="image-counter"></div>

    <div class="thumbnail-strip">

        <% project.gallery.forEach((image,index)=>{ %>

            <img
                src="<%= image.url %>"
                class="thumb"
                data-index="<%= index %>"
            >

        <% }) %>

    </div>

</div>

<script>
document.addEventListener("DOMContentLoaded", () => {

const gallery = [...document.querySelectorAll('.gallery-image')];
const lightbox = document.querySelector('#lightbox');
const lightboxImage = document.querySelector('#lightbox-image');
const counter = document.querySelector('.image-counter');
const thumbs = [...document.querySelectorAll('.thumb')];

let current = 0;

function showImage(index){
current=index;
lightboxImage.src=gallery[index].src;
counter.textContent=`${index+1} / ${gallery.length}`;
thumbs.forEach(t=>t.classList.remove('active'));
thumbs[index].classList.add('active');
}

gallery.forEach((img,index)=>{
img.addEventListener('click',()=>{
lightbox.classList.add('active');
showImage(index);
});
});

document.querySelector('.close-btn').onclick=()=>{
lightbox.classList.remove('active');
}

document.querySelector('.next-btn').onclick=()=>{
showImage((current+1)%gallery.length);
}

document.querySelector('.prev-btn').onclick=()=>{
showImage((current-1+gallery.length)%gallery.length);
}
thumbs.forEach((thumb,index)=>{
thumb.onclick=()=>showImage(index);
});

document.addEventListener('keydown',(e)=>{
if(!lightbox.classList.contains('active')) return;

if(e.key==="ArrowRight"){
showImage((current+1)%gallery.length);
}

if(e.key==="ArrowLeft"){
showImage((current-1+gallery.length)%gallery.length);
}

if(e.key==="Escape"){
lightbox.classList.remove('active');
}
});
});
</script>

  </body>
</html>
